<?xml version="1.0" encoding="UTF-8"?>
<etl xmlns="http://labkey.org/etl/xml">
    <name>ExportASIObservations</name>
    <description>Sync ASI Observations edits to CAMP</description>
    <transforms>
        <transform id="step1" type="org.labkey.di.pipeline.TransformTask">
            <description>Copy to target</description>
            <source schemaName="snprc_ehr" queryName="ExportASIObservations" />
            <destination schemaName="tacSrc" queryName="ASIObservations" bulkLoad="true" targetOption="merge">
                <alternateKeys>
                    <column name="objectid"/>
                </alternateKeys>
                <columnTransforms>
                    <column source="createdBy" target="createdBy" transformClass="org.labkey.snprc_ehr.columnTransforms.UserTransform"/>
                    <column source="modifiedBy" target="modifiedBy" transformClass="org.labkey.snprc_ehr.columnTransforms.UserTransform"/>
                </columnTransforms>
            </destination>
        </transform>
        <transform id="step2" type="TaskrefTransformStep">
            <description>Fan merged edits out to CAMP's live BiocontainmentObservation table</description>
            <taskref ref="org.labkey.snprc_ehr.steps.ASIObservationsFanOutTask" />
        </transform>
    </transforms>
    <incrementalFilter className="ModifiedSinceFilterStrategy" timestampColumnName="modified">
    </incrementalFilter>
    <schedule>
        <poll interval="1h" />
    </schedule>
</etl>
