<?xml version="1.0" encoding="UTF-8"?>
<etl xmlns="http://labkey.org/etl/xml">
    <name>Biocontainment Observations</name>
    <description>Biocontainment Observations</description>
    <transforms>
        <transform id="step1" type="org.labkey.di.pipeline.TransformTask">
            <description>Copy to target</description>
            <source schemaName="snprcSrc" queryName="v_BiocontainmentObservations" />
            <destination schemaName="study" queryName="BiocontainmentObservations" batchSize="10000" bulkLoad="true" targetOption="merge">
                <alternateKeys>
                    <column name="objectid"/>
                </alternateKeys>
                <columnTransforms>
                    <column source="createdBy" target="createdBy" transformClass="org.labkey.snprc_ehr.columnTransforms.UserTransform"/>
                    <column source="modifiedBy" target="modifiedBy" transformClass="org.labkey.snprc_ehr.columnTransforms.UserTransform"/>
                </columnTransforms>
                <!-- The dataset only takes a QC state from a column present in the source; without it every row lands as the
                     study default (Completed) and the trigger's Review Required is dropped. The trigger decides the final value. -->
                <constants>
                    <column name="QCStateLabel" type="VARCHAR" value="Review Required"/>
                </constants>
            </destination>
        </transform>
        <transform id="step2" type="TaskrefTransformStep">
            <description>Log audit events for merged rows</description>
            <taskref ref="org.labkey.snprc_ehr.steps.BiocontainmentObservationsAuditLogTask" />
        </transform>
    </transforms>
    <incrementalFilter className="ModifiedSinceFilterStrategy" timestampColumnName="timestamp">
        <deletedRowsSource schemaName="snprcSrc" queryName="v_delete_BiocontainmentObservations" timestampColumnName="audit_date_tm" deletedSourceKeyColumnName="OBJECT_ID" targetKeyColumnName="objectid"/>
    </incrementalFilter>
    <schedule>
        <poll interval="10m" />
    </schedule>
</etl>