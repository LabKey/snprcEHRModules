<?xml version="1.0" encoding="UTF-8"?>
<etl xmlns="http://labkey.org/etl/xml">
    <name>ASI Observations</name>
    <description>ASI Observations</description>
    <transforms>
        <transform id="step1" type="org.labkey.di.pipeline.TransformTask">
            <description>Copy to target</description>
            <source schemaName="snprcSrc" queryName="v_ASI_observations" />
            <destination schemaName="study" queryName="ASIObservations" batchSize="10000" bulkLoad="true" targetOption="merge">
                <alternateKeys>
                    <column name="objectid"/>
                </alternateKeys>
                <columnTransforms>
                    <column source="createdBy" target="createdBy" transformClass="org.labkey.snprc_ehr.columnTransforms.UserTransform"/>
                    <column source="modifiedBy" target="modifiedBy" transformClass="org.labkey.snprc_ehr.columnTransforms.UserTransform"/>
                </columnTransforms>
            </destination>
        </transform>
        <transform id="step2" type="TaskrefTransformStep">
            <description>Log audit events for merged rows</description>
            <taskref ref="org.labkey.snprc_ehr.steps.ASIObservationsAuditLogTask" />
        </transform>
    </transforms>
    <incrementalFilter className="ModifiedSinceFilterStrategy" timestampColumnName="timestamp">
        <deletedRowsSource schemaName="snprcSrc" queryName="v_delete_ASI_observations" timestampColumnName="audit_date_tm" deletedSourceKeyColumnName="OBJECT_ID" targetKeyColumnName="objectid"/>
    </incrementalFilter>
    <schedule>
        <poll interval="60m" />
    </schedule>
</etl>
