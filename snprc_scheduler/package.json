{
  "name": "snprc_scheduler",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "npm run build-dev",
    "build-analyze": "cross-env ANALYZE=true npm run build",
    "build-dev": "npm run clean && cross-env NODE_ENV=development rspack build --config node_modules/@labkey/build/configs/dev.config.js",
    "build-prod": "npm run clean && cross-env NODE_ENV=production rspack build --config node_modules/@labkey/build/configs/prod.config.js",
    "clean": "rimraf resources/web/snprc_scheduler/gen && rimraf resources/views/gen && rimraf resources/web/gen",
    "start": "cross-env NODE_ENV=development rspack serve --config node_modules/@labkey/build/configs/watch.config.js",
    "setup": "npm ci --legacy-peer-deps",
    "teamcity": "cross-env NODE_ENV=test jest --testResultsProcessor=jest-teamcity-reporter",
    "test": "cross-env NODE_ENV=test jest",
    "lint": "npx eslint",
    "lint-fix": "npx eslint --fix",
    "lint-precommit": "node lint.diff.mjs",
    "lint-precommit-fix": "node lint.diff.mjs --fix",
    "lint-branch": "node lint.diff.mjs --currentBranch",
    "lint-branch-fix": "node lint.diff.mjs --currentBranch --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LabKey/snprcEHRModules.git"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.2.0",
    "@fortawesome/fontawesome-svg-core": "7.2.0",
    "@fortawesome/free-regular-svg-icons": "7.2.0",
    "@fortawesome/free-solid-svg-icons": "7.2.0",
    "@fortawesome/react-fontawesome": "3.3.1",
    "bootstrap": "5.3.8",
    "font-awesome": "4.7.0",
    "moment": "2.30.1",
    "prop-types": "15.8.1",
    "react": "19.2.7",
    "react-bootstrap": "2.10.10",
    "react-data-grid": "7.0.0-beta.59",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.7",
    "react-moment": "2.0.2",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "redux-thunk": "3.1.0"
  },
  "devDependencies": {
    "@labkey/build": "10.1.0",
    "@labkey/eslint-config": "1.2.3",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "execa": "10.0.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-teamcity-reporter": "0.9.0",
    "raf": "3.4.1",
    "ts-jest": "29.4.12"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
